# FlowLens - Rust workspace for Windows proxy-less HTTP/HTTPS debugger

# Rust build output
/target/
**/target/
*.pdb
*.exe
*.dll
*.dylib
*.so

# Rust artifacts / caches
# Cargo.lock is committed intentionally for reproducible builds

# IDE
# Keep project launch/tasks configs for reproducible dev environment; ignore user-specific IDE state.
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.swp

# OS noise
Thumbs.db
desktop.ini
*.tmp
*.temp

# Build-time helper output (kept out of version control)
*.obj
*.ilk
*.exp
*.iobj

# Driver build output
*.sys

# TLS / CA material
*.pfx
*.key
*.crt
*.pem

# Local data
*.db
*.sqlite
*.sqlite3
flowlens_data/
*.har
*.saz
*.zip

# UI build output
ui/node_modules/
ui/dist/
ui/.vite/
ui/src-tauri/target/
ui/src-tauri/gen/

# Local Cargo home / registry cache (created by sandboxed builds)
.cargo-home/

# Ad-hoc test / QA output captured during development
check_out.txt
qa_test_output.txt
test_out.txt
*.log
test_link.log
test_run.log
build_check.log
qa_*.txt

# Local scripts used for one-off maintenance commits (not part of the product)
commit_all_files.ps1
commit_each_file.ps1
commit_dirs.ps1
commit_phase1.ps1
commit_final.ps1
untrack_artifacts.ps1

# QA / build scratch output (generated locally while verifying, never shipped)
clippy*.txt
cargo_check*.txt
cargo_clippy_out.txt
npm_build_out*.txt
build_err.txt
build_out.txt
build_full.txt
buildlog.txt
build_shortcuts.txt
final_tests.txt
vitest_new.txt
core_clippy.txt
tls_test.txt
clippy_err.txt
clippy_out.txt
test.txt

# Note: Npcap import libraries (wpdlib/*.lib, wpdlib/*.def) ARE committed on
# purpose so the crate builds on a plain Windows host with only the Npcap
# runtime installed. See wpdlib/README.md.


# Playwright test artifacts
ui/test-results/

# VS Code user-specific state
.vscode/extensions.json
