{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "FlowLens 主窗口默认能力集：允许核心 API（事件监听、路径、窗口等）以及打包内置插件的最小权限。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:app:default",
    "core:path:default",
    "core:webview:default",
    "shell:allow-open"
  ]
}