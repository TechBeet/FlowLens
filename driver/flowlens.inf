; FlowLens WFP Callout Driver INF
[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%ProviderName%
DriverVer=10/14/2026,0.1.0.0
CatalogFile=flowlens.cat

[DestinationDirs]
DefaultDestDir = 12

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
flowlens.sys=1

[Manufacturer]
%ManufacturerName%=Standard,NT$ARCH$

[Standard.NT$ARCH$]
%Flowlens.DeviceDesc%=Flowlens_Device, root\flowlens

[Flowlens_Device.NT]
CopyFiles=FlowlensFile.CopyDir
AddReg=Flowlens_AddReg

[FlowlensFile.CopyDir]
flowlens.sys

[Flowlens_Device.NT.HW]
AddReg=Flowlens_AddReg

[Flowlens_AddReg]
HKR,Parameters,StartType,0x00010001,3
HKR,Parameters,ErrorControl,0x00010001,1

[Flowlens_Device.NT.Services]
AddService = flowlens, 0x00000002, Flowlens_Service_Inst

[Flowlens_Service_Inst]
DisplayName = %ServiceDesc%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %12%\flowlens.sys

[Strings]
ProviderName="FlowLens"
ManufacturerName="FlowLens Project"
DiskName="FlowLens Driver Disk"
Flowlens.DeviceDesc="FlowLens WFP Callout Driver"
ServiceDesc="FlowLens WFP Callout Driver Service"
