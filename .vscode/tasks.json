{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ui: dev",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/ui"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*VITE.*$",
          "endsPattern": "ready in|localhost:3000"
        }
      }
    },
    {
      "label": "ui: preview",
      "type": "shell",
      "command": "npm run build; npm run preview",
      "options": {
        "cwd": "${workspaceFolder}/ui"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": {
        "owner": "vite-preview",
        "pattern": { "regexp": "^.*$", "file": 1, "location": 2, "message": 3 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*[Vv]ite.*$",
          "endsPattern": "Local:.*4173|localhost:4173"
        }
      }
    },
    {
      "label": "ui: test (vitest run)",
      "type": "shell",
      "command": "npm test",
      "options": {
        "cwd": "${workspaceFolder}/ui"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "rust: fmt check",
      "type": "shell",
      "command": "cargo fmt --all --check",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "rust: clippy (-D warnings)",
      "type": "shell",
      "command": "cargo clippy --workspace --all-targets -- -D warnings",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "ui: stop dev",
      "command": "echo ${input:terminateTask}",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "ui: build",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}/ui"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "tauri: build (debug)",
      "dependsOrder": "sequence",
      "dependsOn": ["ui: build", "tauri: cargo build (debug)"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "tauri: cargo build (debug)",
      "type": "shell",
      "command": "cargo build",
      "options": {
        "cwd": "${workspaceFolder}/ui/src-tauri"
      },
      "group": "build",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "tauri: dev (npm run tauri dev)",
      "type": "shell",
      "command": "npm run tauri dev",
      "options": {
        "cwd": "${workspaceFolder}/ui"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": {
        "owner": "rust",
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*Compiling.*$",
          "endsPattern": "^(Running|Finished|warning: unused).*$"
        }
      }
    },
    {
      "label": "cli: build (debug)",
      "type": "shell",
      "command": "cargo build",
      "options": {
        "cwd": "${workspaceFolder}/crates/flowlens-cli"
      },
      "group": "build",
      "problemMatcher": ["$rustc"]
    }
  ],
  "inputs": [
    {
      "id": "terminateTask",
      "type": "command",
      "command": "workbench.action.tasks.terminate",
      "args": "terminateAll"
    }
  ]
}